{
  "openapi": "3.0.3",
  "info": {
    "title": "gost-deploy local management API",
    "version": "1.0.0",
    "description": "Loopback only. No CORS. Secrets are write-only. No install/upgrade/uninstall HTTP endpoints."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:18080/api/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/status": {
      "get": {
        "summary": "Service and runtime status",
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                },
                "description": "Quoted config revision"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "revision"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Status"
                    },
                    "revision": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid config or operation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid Bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Revision conflict, migration required or stopped service",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/nodes": {
      "get": {
        "summary": "Node health",
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                },
                "description": "Quoted config revision"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "revision"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/NodeHealth"
                      }
                    },
                    "revision": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid config or operation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid Bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Revision conflict, migration required or stopped service",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/profiles": {
      "get": {
        "summary": "Profiles and node health",
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                },
                "description": "Quoted config revision"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "revision"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "type": {
                            "enum": [
                              "direct",
                              "pool"
                            ]
                          },
                          "active": {
                            "type": "boolean"
                          },
                          "nodes": {
                            "type": "array",
                            "items": {
                              "$ref": "#/components/schemas/NodeHealth"
                            }
                          }
                        }
                      }
                    },
                    "revision": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid config or operation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid Bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Revision conflict, migration required or stopped service",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/config": {
      "get": {
        "summary": "Read redacted configuration",
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                },
                "description": "Quoted config revision"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "revision"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Config"
                    },
                    "revision": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid config or operation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid Bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Revision conflict, migration required or stopped service",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Apply full configuration transactionally",
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                },
                "description": "Quoted config revision"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "revision"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Status"
                    },
                    "revision": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid config or operation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid Bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Revision conflict, migration required or stopped service",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "428": {
            "description": "If-Match required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Config"
              }
            }
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "If-Match",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Quoted revision from GET /config ETag"
          }
        ]
      }
    },
    "/config/validate": {
      "post": {
        "summary": "Static validation only",
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                },
                "description": "Quoted config revision"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "revision"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "valid": {
                          "type": "boolean"
                        },
                        "runtimeValidated": {
                          "type": "boolean",
                          "enum": [
                            false
                          ]
                        }
                      }
                    },
                    "revision": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid config or operation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid Bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Revision conflict, migration required or stopped service",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Config"
              }
            }
          }
        }
      }
    },
    "/active-profile": {
      "put": {
        "summary": "Switch new connections; acknowledge applied revision",
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                },
                "description": "Quoted config revision"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "revision"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Status"
                    },
                    "revision": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid config or operation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid Bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Revision conflict, migration required or stopped service",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "428": {
            "description": "If-Match required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "If-Match",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Quoted revision from GET /config ETag"
          }
        ]
      }
    },
    "/profiles/{name}/probe": {
      "post": {
        "summary": "Probe profile now, respecting cooldown",
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                },
                "description": "Quoted config revision"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "revision"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/NodeHealth"
                      }
                    },
                    "revision": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid config or operation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid Bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Revision conflict, migration required or stopped service",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Auth": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "username"
        ],
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "writeOnly": true,
            "description": "Required for new identities; omission retains existing secret."
          },
          "passwordSet": {
            "type": "boolean",
            "readOnly": true
          }
        }
      },
      "Node": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "addr"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "http",
              "socks5"
            ]
          },
          "addr": {
            "type": "string"
          },
          "auth": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "username"
            ],
            "properties": {
              "username": {
                "type": "string"
              },
              "password": {
                "type": "string",
                "writeOnly": true,
                "description": "Required for new identities; omission retains existing secret."
              },
              "passwordSet": {
                "type": "boolean",
                "readOnly": true
              }
            },
            "nullable": true
          }
        }
      },
      "Probe": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "tcp",
              "http"
            ]
          },
          "addr": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "interval": {
            "type": "number",
            "minimum": 1,
            "maximum": 86400,
            "default": 30
          },
          "timeout": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 60,
            "default": 5
          },
          "expectedStatus": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599,
            "default": 200
          }
        },
        "description": "TCP requires addr; HTTP/HTTPS requires url. Explicit target, no URL credentials or redirects."
      },
      "Profile": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "direct"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type",
              "nodes",
              "probe"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "pool"
                ]
              },
              "nodes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/components/schemas/Node"
                }
              },
              "probe": {
                "$ref": "#/components/schemas/Probe"
              }
            }
          }
        ]
      },
      "Config": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaVersion",
          "listener",
          "profiles",
          "activeProfile"
        ],
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "enum": [
              2
            ]
          },
          "listener": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "addr",
              "udp",
              "users"
            ],
            "properties": {
              "addr": {
                "type": "string"
              },
              "udp": {
                "type": "boolean"
              },
              "users": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/components/schemas/Auth"
                }
              }
            }
          },
          "activeProfile": {
            "type": "string"
          },
          "profiles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/Profile"
            }
          }
        }
      },
      "Status": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "arch": {
            "type": "string"
          },
          "active": {
            "type": "boolean"
          },
          "enabled": {
            "type": "boolean"
          },
          "activeProfile": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          },
          "available": {
            "type": "boolean"
          },
          "healthyNodes": {
            "type": "integer"
          },
          "connections": {
            "type": "integer"
          },
          "frontendPid": {
            "type": "integer",
            "nullable": true
          }
        }
      },
      "NodeHealth": {
        "type": "object",
        "required": [
          "profile",
          "id",
          "type",
          "addr",
          "healthy"
        ],
        "properties": {
          "profile": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "http",
              "socks5"
            ]
          },
          "addr": {
            "type": "string"
          },
          "healthy": {
            "type": "boolean",
            "nullable": true
          },
          "lastProbe": {
            "type": "number",
            "nullable": true,
            "description": "Unix seconds"
          },
          "latencyMs": {
            "type": "number",
            "nullable": true
          },
          "failures": {
            "type": "integer"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
