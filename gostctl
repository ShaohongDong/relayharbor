#!/usr/bin/env python3
"""CLI launcher; installed modules are independent of the checkout."""
import sys
from pathlib import Path

if not (Path(__file__).resolve().parent / "gost_deploy").is_dir():
    sys.path.insert(0, "/usr/local/lib/gost-deploy")

from gost_deploy.lifecycle import entrypoint

if __name__ == "__main__":
    entrypoint()
